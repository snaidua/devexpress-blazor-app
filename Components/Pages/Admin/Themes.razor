@page "/admin/themes"
@inject AppStateService AppState
@inject IJSRuntime JSRuntime

<PageTitle>Theme & Appearance Customization - APEX ERP</PageTitle>

<div class="container-fluid p-0">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1 text-dark">
                <i class="bi bi-palette-fill text-primary me-2"></i>Theme & Enterprise Appearance
            </h3>
            <p class="text-secondary small mb-0">
                Personalize and persist the active DevExpress Blazor design system across your user profile and tenant circuits.
            </p>
        </div>
        <div>
            <span class="badge bg-primary px-3 py-2 fs-6">
                Active Theme: <strong>@AppState.CurrentTheme</strong>
            </span>
        </div>
    </div>

    <!-- Theme Selection Grid -->
    <div class="row g-4 mb-4">
        @foreach (var theme in _availableThemes)
        {
            var isCurrent = AppState.CurrentTheme == theme.Key;
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card h-100 shadow-sm border @(isCurrent ? "border-primary border-2 shadow" : "border-light") bg-white">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h5 class="fw-bold text-dark mb-1">@theme.Name</h5>
                                <span class="badge bg-secondary font-monospace small">@theme.Key</span>
                            </div>
                            @if (isCurrent)
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle-fill me-1"></i>Applied
                                </span>
                            }
                        </div>

                        <p class="text-muted small flex-grow-1">
                            @theme.Description
                        </p>

                        <!-- Theme Color Preview Bar -->
                        <div class="d-flex gap-2 my-3 p-2 rounded bg-light border">
                            @foreach (var color in theme.PreviewColors)
                            {
                                <div style="flex: 1; height: 28px; background-color: @color; border-radius: 4px; box-shadow: inset 0 0 2px rgba(0,0,0,0.2);"></div>
                            }
                        </div>

                        <div class="mt-3">
                            <DxButton Text="@(isCurrent ? "Active Theme" : "Apply This Theme")"
                                      IconCssClass="@(isCurrent ? "bi bi-check2" : "bi bi-brush")"
                                      RenderStyle="@(isCurrent ? ButtonRenderStyle.Success : ButtonRenderStyle.Primary)"
                                      RenderStyleMode="@(isCurrent ? ButtonRenderStyleMode.Contained : ButtonRenderStyleMode.Outline)"
                                      CssClass="w-100"
                                      Click="@(() => ApplyThemeAsync(theme.Key))" />
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Live Component Showcase Card -->
    <div class="card shadow-sm border-0 p-4 bg-white">
        <h5 class="fw-bold text-dark mb-3">
            <i class="bi bi-eye-fill text-info me-2"></i>Live Theme Component Preview
        </h5>
        <p class="text-secondary small mb-4">
            The DevExpress editors and buttons below automatically reflect styles from the selected stylesheet.
        </p>

        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-bold">Sample Text Box</label>
                <DxTextBox Text="Apex ERP Industrial Engine" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Date Picker</label>
                <DxDateEdit Date="@DateTime.Today" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Numeric Stepper</label>
                <DxSpinEdit Value="150" MinValue="0" MaxValue="1000" />
            </div>
            <div class="col-md-3">
                <div class="d-flex gap-2">
                    <DxButton Text="Primary" RenderStyle="ButtonRenderStyle.Primary" />
                    <DxButton Text="Success" RenderStyle="ButtonRenderStyle.Success" />
                    <DxButton Text="Danger" RenderStyle="ButtonRenderStyle.Danger" />
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private record ThemeDefinition(string Key, string Name, string Description, string[] PreviewColors);

    private readonly List<ThemeDefinition> _availableThemes = new()
    {
        new("blazing-berry", "Blazing Berry", "Default modern corporate purple-accent theme with clean typography and high contrast.", new[] { "#5925dc", "#7f56d9", "#f9f5ff", "#101828" }),
        new("blazing-dark", "Blazing Dark", "High-focus dark mode designed for mission-critical operations centers and low-light environments.", new[] { "#0f172a", "#1e293b", "#38bdf8", "#f8fafc" }),
        new("office-white", "Office White", "Crisp, classic enterprise white styling matching Microsoft Office and Excel standards.", new[] { "#0078d4", "#2b88d8", "#f3f2f1", "#201f1e" }),
        new("purple", "Royal Purple", "Vibrant purple palette engineered for creative and executive dashboard presentations.", new[] { "#6b21a8", "#9333ea", "#f3e8ff", "#1e1b4b" }),
        new("fluent-light", "Fluent Light", "Clean Microsoft Fluent UI aesthetic with rounded elements and subtle shadows.", new[] { "#005fb8", "#60cdff", "#f9f9f9", "#1b1b1b" })
    };

    private async Task ApplyThemeAsync(string themeKey)
    {
        AppState.ShowLoading($"Applying DevExpress '{themeKey}' theme...");
        try
        {
            await AppState.SetThemeAsync(themeKey);
            // Invoke client-side stylesheet link replacement
            await JSRuntime.InvokeVoidAsync("switchTheme", themeKey);
            AppState.ShowToast($"Theme '{themeKey}' loaded and saved to your profile", "Theme Applied", ToastNotificationType.Success);
        }
        catch (Exception ex)
        {
            await AppState.HandleGlobalErrorAsync(ex, "Failed to apply and persist theme.");
        }
        finally
        {
            AppState.HideLoading();
        }
    }
}

